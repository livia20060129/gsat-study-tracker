{
  "name": "gsat-study-tracker-v171",
  "private": true,
  "version": "171.6.36",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "typecheck:edge": "deno check --config supabase/functions/google-calendar/deno.json --frozen supabase/functions/google-calendar/index.ts && deno check --config supabase/functions/google-calendar-callback/deno.json --frozen supabase/functions/google-calendar-callback/index.ts",
    "test": "node --experimental-strip-types --test \"tests/*.test.ts\"",
    "test:e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "wrangler": "4.132.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.114.0"
  }
}
