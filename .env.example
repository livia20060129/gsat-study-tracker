# This tracked file must always keep the placeholder below.
# Copy it to .env.local, then edit only the untracked .env.local copy.
# The Google OAuth Web client ID is a public browser identifier, not a secret.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# VITE_GOOGLE_CLIENT_ID is the only approved VITE_ variable in this project.
# Never add a client secret, token, password, private key, service-role key, or
# database URL here. The build rejects every unapproved VITE_ variable because
# Vite intentionally exposes those values in the generated browser bundle.
